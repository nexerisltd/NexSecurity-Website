+ * Server Component page can't pass those in directly (React elements
+ * themselves ARE serializable, the same way `children` always has been,
+ * which is why this shape works and a function-prop shape doesn't).
+ */
+export function SearchableGrid({
   items,
-  getSearchText,
-  getKey,
