# ── Supabase ────────────────────────────────────────────────────────────
# Public by design — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
# Bypasses Row-Level Security — only read in lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google OAuth ────────────────────────────────────────────────────────
# These are configured in the Supabase Dashboard under
# Authentication → Providers → Google — NOT read directly by this app's
# code, so they are not Next.js env vars. Listed here for reference only:
#   Client ID:     (set in Supabase Dashboard)
#   Client Secret: (set in Supabase Dashboard, never in this repo)

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nexsecurity.vercel.app

# ── Bunny Stream (video downloads) ─────────────────────────────────────
# SERVER-SIDE ONLY. Powers the "Download" button on the video page
# (components/VideoDownloadButton.tsx → app/api/video/[id]/download).
# Without these set, bunnyDownloadConfigured() returns false and the
# button falls back to each video's manually-pasted download_url (or
# hides itself if there isn't one).
#
#   BUNNY_STREAM_LIBRARY_ID        Bunny dashboard → Stream → your library → ID
#   BUNNY_STREAM_API_KEY           Same library → API → "Video Library API Key"
#   BUNNY_PULL_ZONE_HOSTNAME       Your Stream pull zone hostname, no https://
#                                  e.g. vz-a3fb7c6a-b8f.b-cdn.net
#   BUNNY_TOKEN_AUTH_ENABLED       "true" if that pull zone has Token
#                                  Authentication turned on (Security tab),
#                                  otherwise omit this line entirely
#   BUNNY_TOKEN_AUTH_SECURITY_KEY  Pull zone → Security → Token Authentication
#                                  Key — only needed if the line above is "true"
BUNNY_STREAM_LIBRARY_ID=your-library-id
BUNNY_STREAM_API_KEY=your-stream-api-key
BUNNY_PULL_ZONE_HOSTNAME=vz-your-pull-zone.b-cdn.net
# BUNNY_TOKEN_AUTH_ENABLED=true
# BUNNY_TOKEN_AUTH_SECURITY_KEY=your-token-auth-security-key
