{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // scripts/ holds one-off maintenance scripts run directly via `tsx`,
  // never imported by the app itself — excluding it here keeps its
  // dependencies (e.g. sharp, only needed by
  // scripts/recompress-thumbnails.ts) OUT of what `next build`
  // type-checks, so a script-only package that was never added to
  // package.json can't break a production build.
  // worker/ is a separate deployable (a Cloudflare Worker, see
  // worker/README.md) with its OWN tsconfig.json and its own
  // @cloudflare/workers-types — it doesn't share this project's "dom"
  // lib or dependencies (no KVNamespace/ExportedHandler types here,
  // same reason scripts/ is excluded below). Type-checking it against
  // Next's tsconfig would fail on Workers-only globals; run its
  // typecheck via `npm run typecheck` inside worker/ instead.
  "exclude": ["node_modules", "scripts", "worker"]
}
