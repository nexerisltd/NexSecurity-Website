{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // scripts/ holds one-off maintenance scripts run directly via `tsx`,
  // never imported by the app itself — excluding it here keeps its
  // dependencies (e.g. sharp, only needed by
  // scripts/recompress-thumbnails.ts) OUT of what `next build`
  // type-checks, so a script-only package that was never added to
  // package.json can't break a production build.
  "exclude": ["node_modules", "scripts"]
}
