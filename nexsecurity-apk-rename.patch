diff --git a/.github/workflows/build-android.yml b/.github/workflows/build-android.yml
index 78e4596..36745d7 100644
--- a/.github/workflows/build-android.yml
+++ b/.github/workflows/build-android.yml
@@ -76,13 +76,30 @@ jobs:
         if: always()
         run: rm -f android.keystore
 
+      # Bubblewrap always names its output app-release-signed.apk /
+      # app-release-bundle.aab — renamed here to something meaningful,
+      # with an auto-incrementing version (1.0.<run number>) so every
+      # build gets a unique, human-readable filename with no manual
+      # version bump needed. $GITHUB_ENV makes APK_NAME/AAB_NAME
+      # available to every later step in this job.
+      - name: Rename build outputs
+        run: |
+          VERSION="1.0.${{ github.run_number }}"
+          APK_NAME="NexSecurity-Android_v${VERSION}.apk"
+          AAB_NAME="NexSecurity-Android_v${VERSION}.aab"
+          mv app-release-signed.apk "$APK_NAME"
+          mv app-release-bundle.aab "$AAB_NAME"
+          echo "VERSION=$VERSION" >> "$GITHUB_ENV"
+          echo "APK_NAME=$APK_NAME" >> "$GITHUB_ENV"
+          echo "AAB_NAME=$AAB_NAME" >> "$GITHUB_ENV"
+
       - name: Upload build output
         uses: actions/upload-artifact@v4
         with:
           name: nexsecurity-android-${{ github.run_number }}
           path: |
-            app-release-signed.apk
-            app-release-bundle.aab
+            ${{ env.APK_NAME }}
+            ${{ env.AAB_NAME }}
           if-no-files-found: warn
 
       - name: Create GitHub Release
@@ -91,9 +108,9 @@ jobs:
         run: |
           TAG="android-build-${{ github.run_number }}"
           gh release create "$TAG" \
-            app-release-signed.apk \
-            app-release-bundle.aab \
-            --title "Android build #${{ github.run_number }}" \
+            "$APK_NAME" \
+            "$AAB_NAME" \
+            --title "NexSecurity Android v${VERSION}" \
             --notes "Automated build from commit ${{ github.sha }}."
 
       # Rewrites the README's download link to point at THIS run's
@@ -112,16 +129,16 @@ jobs:
           GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           TAG="android-build-${{ github.run_number }}"
-          URL="https://github.com/${{ github.repository }}/releases/download/${TAG}/app-release-signed.apk"
+          URL="https://github.com/${{ github.repository }}/releases/download/${TAG}/${APK_NAME}"
 
           rm -rf /tmp/readme-clone
           git clone --depth=1 "https://x-access-token:${GH_TOKEN}@github.com/${{ github.repository }}.git" /tmp/readme-clone
           cd /tmp/readme-clone
 
-          perl -0777 -pi -e "s|(<!-- ANDROID_DOWNLOAD_LINK_START -->).*?(<!-- ANDROID_DOWNLOAD_LINK_END -->)|\$1\n\n[⬇ Download latest APK (build #${{ github.run_number }})](${URL})\n\n\$2|s" README.md
+          perl -0777 -pi -e "s|(<!-- ANDROID_DOWNLOAD_LINK_START -->).*?(<!-- ANDROID_DOWNLOAD_LINK_END -->)|\$1\n\n[⬇ Download NexSecurity v${VERSION}](${URL})\n\n\$2|s" README.md
 
           git config user.name "github-actions[bot]"
           git config user.email "github-actions[bot]@users.noreply.github.com"
           git add README.md
-          git diff --cached --quiet && echo "No README changes" || git commit -m "chore: update Android download link (build #${{ github.run_number }}) [skip ci]"
+          git diff --cached --quiet && echo "No README changes" || git commit -m "chore: update Android download link (v${VERSION}) [skip ci]"
           git push
